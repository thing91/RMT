# Copy this to `.env` (same directory as docker-compose.yml) and fill in
# real values before `docker compose up -d --build`. Anything left unset
# falls back to the default baked into docker-compose.yml — fine for a
# first test-server run, not for anything wider.

# --- Database ---
POSTGRES_USER=rmt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rmt_kna

# --- Backend ---
# Required — docker-compose refuses to start the backend without this set.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# The URL people actually use to reach this deployment — used to build
# links in notification emails. Include the scheme, no trailing slash.
APP_BASE_URL=http://localhost

# Only "true" on a server nobody untrusted can reach (internal network/VPN,
# review-only). Set to "false" and fill in the LDAP_* block below before
# sharing this with a wider audience.
DEV_AUTH_FALLBACK=true

# --- LDAP (only used once DEV_AUTH_FALLBACK=false) ---
# See backend/.env.example and README.md "Logging in" for the two auth
# modes (search-and-bind vs. fixed DN template) and which fields each needs.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_FILTER=(uid={username})
LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com

# --- Mail (blank SMTP_HOST writes emails as .html files instead of
# sending them — fine for an initial review, not for real notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=rmt-kna@example.com

# --- Web ---
# Host port the frontend/nginx container listens on.
WEB_PORT=80
