DATABASE_URL=postgresql+psycopg2://rmt:rmt@localhost:5432/rmt_kna

# §13.1 LDAP bind-auth. Leave LDAP_URL empty to use dev-mode auth (any
# username + any non-empty password succeeds) instead of a real directory —
# never leave it empty (or DEV_AUTH_FALLBACK=true) in production.
LDAP_URL=

# Preferred for a real directory (Active Directory included): fill in
# LDAP_BASE_DN and this searches for the user instead of assuming a fixed
# DN pattern. LDAP_BIND_DN/LDAP_BIND_PASSWORD are a service account for the
# search — leave both blank to search anonymously, if your directory
# allows that.
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# OpenLDAP: (uid={username})   Active Directory: (sAMAccountName={username})
LDAP_USER_SEARCH_FILTER=(uid={username})

# Only used when LDAP_BASE_DN is blank — binds directly at this DN, so it's
# only correct if every user's DN follows exactly this pattern.
LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com

DEV_AUTH_FALLBACK=true

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=600

# §7 local Git sync — one repo per project under this root.
GIT_REPO_ROOT=./git_sync_repos
